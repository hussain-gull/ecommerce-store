{
  "name": "api",
  "version": "1.0.0",
  "description": "Express 5 + Prisma REST API for the ecommerce store",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "contract:emit": "prisma contract emit",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "postinstall": "prisma skills sync || exit 0",
    "test:integration": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed:content": "tsx scripts/seed-content.ts"
  },
  "author": "Hussain-Gull",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@ecommerce/contracts": "workspace:*",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "26.4.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "prisma": "8.0.0-rc.14",
    "typescript": "7.0.2"
  }
}
