# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (no sslmode for local dev).
DATABASE_URL=postgres://postgres_username:yourpassword@localhost:5432/ecommerce-store

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=""
# Access token lifetime — any value accepted by jsonwebtoken (e.g. 15m, 1h).
JWT_ACCESS_TTL=""
# Refresh token lifetime — must match REFRESH_COOKIE_TTL_DAYS (in equivalent days).
JWT_REFRESH_TTL=""

# ── bcrypt ────────────────────────────────────────────────────────────────────
# Work factor for bcrypt password hashing. 12 is the production minimum; lower for tests.
BCRYPT_SALT_ROUNDS=12

# ── Refresh cookie ────────────────────────────────────────────────────────────
# Name of the HttpOnly refresh-token cookie sent to the client.
REFRESH_COOKIE_NAME="web_refresh"
# Lifetime of the refresh cookie in whole days. Keep in sync with JWT_REFRESH_TTL.
REFRESH_COOKIE_TTL_DAYS=7

# ── Password reset ────────────────────────────────────────────────────────────
# How long a password-reset link remains valid, in minutes.
RESET_TOKEN_TTL_MINUTES=60

# ── App URLs ──────────────────────────────────────────────────────────────────
# Base URL of the Next.js frontend — used to build the reset-password link in emails.
FRONTEND_URL="http://localhost:3000"

# ── Server ────────────────────────────────────────────────────────────────────
PROCESS_PORT=4000
NODE_ENV=development

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in development — reset URLs are logged to stdout instead.
# Get an API key at https://resend.com (free tier: 3,000 emails/month).
RESEND_API_KEY=
# From address shown to recipients. On the free tier use: onboarding@resend.dev
# On a verified domain use your own address: "My Store" <noreply@example.com>
EMAIL_FROM='your_resend_email_from'


# ── Cloudinary (media uploads) ─────────────────────────────────────────────────
# From your Cloudinary dashboard (Settings → API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder all uploads are namespaced under, e.g. store/home-hero.
CLOUDINARY_ROOT_FOLDER="ecommerce-store"

# ── Admin JWT ─────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=
ADMIN_JWT_ACCESS_TTL="15m"
ADMIN_JWT_REFRESH_TTL="1d"

# ── Admin refresh cookie ──────────────────────────────────────────────────────
ADMIN_REFRESH_COOKIE_NAME="admin_refresh"
ADMIN_REFRESH_COOKIE_TTL_DAYS=1

# ── Admin seed/reset script (pnpm run seed:admin) ────────────────────────────
ADMIN_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Redis (read-through cache) ───────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=300
# Page content, payment details and filter options: invalidated on every admin
# write, so this is only a safety net. Seconds (86400 = 1 day).
CACHE_LONG_TTL_SECONDS=86400

TRUST_PROXY_HOPS=0
RATE_LIMIT_DISABLED=0